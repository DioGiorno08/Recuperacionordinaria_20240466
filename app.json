{
  "expo": {
    "name": "Recuperación Ordinaria David",
    "slug": "recuperacion-david",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/image.png",
      "resizeMode": "contain",
      "backgroundColor": "#1d1d1b"
    },
    "android": {
      "package": "com.davideduardo.recuperacionordinaria",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#10243a"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/image.png",
          "imageWidth": 240,
          "resizeMode": "contain",
          "backgroundColor": "#1d1d1b"
        }
      ]
    ]
  }
}
